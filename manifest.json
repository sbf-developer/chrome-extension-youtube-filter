{
  "manifest_version": 3,
  "name": "Feed Sieve",
  "version": "1.1.0",
  "description": "Filter YouTube recommendations with private, on-device topic rules.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Feed Sieve",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "rules.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ]
}
